#!/bin/bash
# Supervise Tarot, Novel and Hub as separate restartable low-overhead workers.
set -o pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="${PYTHON_BIN:-python3}"
export DSH017_DATA_DIR="${DSH017_DATA_DIR:-$SCRIPT_DIR/data}"

RUN_DIR="$DSH017_DATA_DIR/run"
LOG_DIR="$DSH017_DATA_DIR/logs"
LOCK_FILE="$RUN_DIR/sidecars-supervisor.lock"
PID_FILE="$RUN_DIR/sidecars-supervisor.pid"
MAX_LOG_BYTES=5242880
ROTATE_INTERVAL=10
RESTART_DELAY=3

mkdir -p "$RUN_DIR" "$LOG_DIR"

if ! command -v flock >/dev/null 2>&1; then
  echo "flock 未安装；请在 Ubuntu 容器中安装 util-linux。" >&2
  exit 1
fi

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  echo "Sidecar supervisor 已在运行。" >&2
  exit 1
fi
printf '%s\n' "$$" > "$PID_FILE"

WORKERS=()
STOP_REQUESTED=0

rotate_log() {
  local log_file="$1"
  local size
  [ -f "$log_file" ] || return 0
  size="$(wc -c < "$log_file" 2>/dev/null || echo 0)"
  [ "$size" -ge "$MAX_LOG_BYTES" ] || return 0

  rm -f "$log_file.2"
  [ ! -f "$log_file.1" ] || mv -f "$log_file.1" "$log_file.2"
  cp -f "$log_file" "$log_file.1"
  : > "$log_file"
}

run_service() {
  local service_name="$1"
  local script_name="$2"
  local log_file="$LOG_DIR/$service_name.log"
  local child_pid=""
  local stop_worker=0
  local exit_code=0

  request_worker_stop() {
    stop_worker=1
    if [ -n "$child_pid" ]; then
      kill -TERM "$child_pid" 2>/dev/null || true
    fi
  }
  trap request_worker_stop INT TERM

  while [ "$stop_worker" -eq 0 ]; do
    rotate_log "$log_file"
    printf '[%s] ===== starting %s =====\n' "$(date '+%F %T')" "$script_name" >> "$log_file"

    "$PYTHON_BIN" -u "$SCRIPT_DIR/$script_name" >> "$log_file" 2>&1 &
    child_pid=$!

    while kill -0 "$child_pid" 2>/dev/null; do
      sleep "$ROTATE_INTERVAL"
      rotate_log "$log_file"
      if [ "$stop_worker" -eq 1 ]; then
        kill -TERM "$child_pid" 2>/dev/null || true
      fi
    done

    wait "$child_pid"
    exit_code=$?
    child_pid=""
    printf '[%s] %s exited code=%s\n' "$(date '+%F %T')" "$script_name" "$exit_code" >> "$log_file"

    [ "$stop_worker" -eq 0 ] || break
    sleep "$RESTART_DELAY"
  done

  printf '[%s] worker %s stopped\n' "$(date '+%F %T')" "$service_name" >> "$log_file"
}

shutdown_workers() {
  STOP_REQUESTED=1
  local worker_pid
  for worker_pid in "${WORKERS[@]}"; do
    kill -TERM "$worker_pid" 2>/dev/null || true
  done
  for worker_pid in "${WORKERS[@]}"; do
    wait "$worker_pid" 2>/dev/null || true
  done
}

cleanup() {
  shutdown_workers
  if [ -f "$PID_FILE" ] && [ "$(cat "$PID_FILE" 2>/dev/null)" = "$$" ]; then
    rm -f "$PID_FILE"
  fi
}

trap shutdown_workers INT TERM
trap cleanup EXIT

run_service "tarot" "tarot_server.py" &
WORKERS+=("$!")
run_service "novel" "novel_server.py" &
WORKERS+=("$!")
run_service "hub" "hub_server.py" &
WORKERS+=("$!")

printf '[%s] sidecar supervisor started (tarot, novel, hub)\n' "$(date '+%F %T')"
while [ "$STOP_REQUESTED" -eq 0 ]; do
  local_worker_failed=0
  for worker_pid in "${WORKERS[@]}"; do
    if ! kill -0 "$worker_pid" 2>/dev/null; then
      local_worker_failed=1
    fi
  done
  if [ "$local_worker_failed" -ne 0 ]; then
    echo "检测到 sidecar worker 意外退出，正在停止其余 worker。" >&2
    break
  fi
  sleep 5
done

shutdown_workers
