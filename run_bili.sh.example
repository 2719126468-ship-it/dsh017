#!/bin/bash

# Copy this file to run_bili.sh and set the key in the environment or below.
export ZHIPU_API_KEY="${ZHIPU_API_KEY:-YOUR_ZHIPU_KEY_HERE}"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="${PYTHON_BIN:-python3}"
export DSH017_DATA_DIR="${DSH017_DATA_DIR:-$SCRIPT_DIR/data}"

# Bili Console 守护脚本 · 崩溃自动拉起 + 日志滚动（5MB × 2 份）
LOG="${DSH017_LOG_FILE:-$DSH017_DATA_DIR/bili.log}"
mkdir -p "$(dirname -- "$LOG")"
MAX=5242880

# 停旧进程
pkill -f bili_console.py 2>/dev/null
sleep 1

# 启动前清一次临时音频文件（防止磁盘占满）
rm -f /tmp/tmp*.mp3 /tmp/tmp*.m4a 2>/dev/null

while true; do
  # 日志滚动：超过 5MB 就归档
  if [ -f "$LOG" ] && [ "$(stat -c%s "$LOG" 2>/dev/null || echo 0)" -gt "$MAX" ]; then
    mv -f "$LOG" "$LOG.1"
  fi

  echo "[$(date '+%F %T')] ===== starting bili_console.py =====" >> "$LOG"
  "$PYTHON_BIN" -u "$SCRIPT_DIR/bili_console.py" >> "$LOG" 2>&1
  EXIT=$?
  echo "[$(date '+%F %T')] exited code=$EXIT, restart in 3s" >> "$LOG"
  sleep 3
done
