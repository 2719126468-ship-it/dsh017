#!/bin/bash
# Copy to run_bili.sh, configure ZHIPU_API_KEY, then run in the background.
set -o pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="${PYTHON_BIN:-python3}"
export DSH017_DATA_DIR="${DSH017_DATA_DIR:-$SCRIPT_DIR/data}"
export ZHIPU_API_KEY="${ZHIPU_API_KEY:-YOUR_ZHIPU_KEY_HERE}"

RUN_DIR="$DSH017_DATA_DIR/run"
LOG_DIR="$DSH017_DATA_DIR/logs"
LOG="${DSH017_LOG_FILE:-$LOG_DIR/bili.log}"
LOCK_FILE="$RUN_DIR/bili-supervisor.lock"
PID_FILE="$RUN_DIR/bili-supervisor.pid"
MAX_LOG_BYTES=5242880
ROTATE_INTERVAL=10
RESTART_DELAY=3

mkdir -p "$RUN_DIR" "$LOG_DIR" "$(dirname -- "$LOG")"

if ! command -v flock >/dev/null 2>&1; then
  echo "flock 未安装；请在 Ubuntu 容器中安装 util-linux。" >&2
  exit 1
fi

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  echo "Bilibili supervisor 已在运行。" >&2
  exit 1
fi
printf '%s\n' "$$" > "$PID_FILE"

STOP_REQUESTED=0
CHILD_PID=""

process_is_running() {
  local process_id="$1"
  local state
  kill -0 "$process_id" 2>/dev/null || return 1
  state="$(ps -p "$process_id" -o stat= 2>/dev/null | tr -d '[:space:]' || true)"
  case "$state" in
    Z*|X*) return 1 ;;
  esac
  return 0
}

rotate_log() {
  local size
  [ -f "$LOG" ] || return 0
  size="$(wc -c < "$LOG" 2>/dev/null || echo 0)"
  [ "$size" -ge "$MAX_LOG_BYTES" ] || return 0

  rm -f "$LOG.2"
  [ ! -f "$LOG.1" ] || mv -f "$LOG.1" "$LOG.2"
  cp -f "$LOG" "$LOG.1"
  : > "$LOG"
}

request_stop() {
  STOP_REQUESTED=1
  if [ -n "$CHILD_PID" ]; then
    kill -TERM "$CHILD_PID" 2>/dev/null || true
  fi
}

cleanup() {
  request_stop
  if [ -n "$CHILD_PID" ]; then
    while kill -0 "$CHILD_PID" 2>/dev/null; do
      wait "$CHILD_PID" 2>/dev/null || true
    done
  fi
  if [ -f "$PID_FILE" ] && [ "$(cat "$PID_FILE" 2>/dev/null)" = "$$" ]; then
    rm -f "$PID_FILE"
  fi
}

trap request_stop INT TERM
trap cleanup EXIT

while [ "$STOP_REQUESTED" -eq 0 ]; do
  rotate_log
  printf '[%s] ===== starting bili_console.py =====\n' "$(date '+%F %T')" >> "$LOG"
  "$PYTHON_BIN" -u "$SCRIPT_DIR/bili_console.py" >> "$LOG" 2>&1 &
  CHILD_PID=$!

  ROTATE_TICKS=0
  while process_is_running "$CHILD_PID"; do
    sleep 1
    ROTATE_TICKS=$((ROTATE_TICKS + 1))
    if [ "$((ROTATE_TICKS % ROTATE_INTERVAL))" -eq 0 ]; then
      rotate_log
    fi
    if [ "$STOP_REQUESTED" -eq 1 ]; then
      kill -TERM "$CHILD_PID" 2>/dev/null || true
    fi
  done

  wait "$CHILD_PID"
  EXIT_CODE=$?
  CHILD_PID=""
  printf '[%s] bili_console.py exited code=%s\n' "$(date '+%F %T')" "$EXIT_CODE" >> "$LOG"

  [ "$STOP_REQUESTED" -eq 0 ] || break
  sleep "$RESTART_DELAY"
done

echo "Bilibili supervisor stopped."
